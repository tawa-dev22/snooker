# =========================================================================
# SNOOKER LEAGUE & TOURNAMENT MANAGEMENT SYSTEM - BACKEND ENV TEMPLATE
# =========================================================================

# Server configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas Connection
# Replace with your actual SRV connection string from MongoDB Atlas console
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/snooker_db?retryWrites=true&w=majority

# Security (JWT secret for Admin Authentication)
JWT_SECRET=super_secret_jwt_key_change_in_production

# CORS Configurations
# FRONTEND_URL is used in production (e.g. https://snooker-league.vercel.app)
# If not provided, backend falls back to ALLOWED_ORIGINS (separated by comma) or localhost
FRONTEND_URL=https://snooker-league-frontend.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,https://snooker-league-frontend.vercel.app
